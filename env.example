# ─── VARIABLES DE ENTORNO ───────────────────────────────────
# Copiá este archivo como .env y completá los valores
# En Railway, cargás estas variables desde el dashboard (NO subas este archivo)

# Token de tu bot de Discord
# Lo obtenés en: https://discord.com/developers/applications
DISCORD_TOKEN=tu_token_de_discord_aqui

# Nombre de tu canal en Kick (sin la URL, solo el nombre)
# Ejemplo: si tu canal es kick.com/micanal → ponés "micanal"
KICK_CHANNEL=nombre_de_tu_canal_kick

# Nombre exacto del rol VIP en tu servidor de Discord
# Asegurate que exista y que el bot tenga permisos para asignarlo
VIP_ROLE_NAME=VIP Subs

# (Opcional) ID del canal de Discord donde se puede usar !verificar
# Dejalo vacío para permitir el comando en cualquier canal
# Para obtener el ID: click derecho en el canal → "Copiar ID"
VERIFY_CHANNEL_ID=
